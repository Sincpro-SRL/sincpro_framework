          "version": "repo-lines-v1:sha256:d877e10a4b9fa68aa1f48a17ecade80553ada2ce6c7c8e1d9ab63f945e516205:"
        }
      ]
    },
    {
      "id": "claim_02075e0d23f04609be8aee6f40d90178",
      "statement": "Constructing `Catalog(instance)` builds the root bus when `was_initialized` is false, so merely constructing a host materialises the registries; `get_scalar_use_cases()` re-checks the same guard before projecting.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L131-L132",
          "version": "repo-lines-v1:sha256:06754266288a3e93c1172522e82f300e434c3d78455764f0e2eaefbd6adc5c0b:"
