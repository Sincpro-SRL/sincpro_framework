    {
      "id": "claim_91bb5716bb6440c1899a6d1d922f356f",
      "statement": "`scalar_executor.extract_executor_fn` is a factory, not an inline loop closure, so each bound `run` captures its own `dto_type`; the bound body is exactly `framework_instance(dto_type.model_validate(payload))` followed by `dump_scalar_result(result)`, meaning Value Object `validate_fn` runs on wire input and `UseFramework.__call__` still receives a typed DTO.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/scalar_executor.py#L1-L7",
          "version": "repo-lines-v1:sha256:250c27c1e5c2df94739f783dbd66b68f0f1ca76b1ed50ffa8ab6021ee4b6f0a1:"
