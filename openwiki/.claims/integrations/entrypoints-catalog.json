    {
      "id": "claim_32232264a0bf407685d8704bd78a4e3a",
      "statement": "What a new host must not do: put FastMCP/Starlette/argparse types in the shared layer, walk the DTO schema or recompute `json_schema` instead of using the precomputed one, treat Value Objects as published operations (they are field types), skip `ApplicationService`s (both layers are published by default), or share an HTTP port with FastMCP, which already speaks JSON-RPC with its own methods.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/entrypoint_mcp.md#L81-L81",
          "version": "repo-lines-v1:sha256:630e3f6b330cce7eb8167f68739eb95205f88959703d5a53670aa27f1737a7cc:"
