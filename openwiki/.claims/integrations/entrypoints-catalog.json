          "version": "repo-lines-v1:sha256:a0f407dbf9ee3bc3d1351d5040925ca62d7a012d8557547b21b0386979402adc:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/rpc/entrypoint.py#L56-L56",
          "version": "repo-lines-v1:sha256:d56e43d189472129d2f65c427d2ad0f9edc1ac0b0db58766a64cc2a1c719b221:"
        }
      ]
    },
    {
      "id": "claim_0df053e1f2a54ce293ab8981ac24afba",
      "statement": "The catalog projection is recomputed on every `get_scalar_use_cases()` call: each call re-walks the registries and builds fresh `PackedFeatureOrAppService` entries, fresh `run` closures and fresh JSON schemas, so policy applied after an earlier projection still takes effect on the next one.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L134-L145",
          "version": "repo-lines-v1:sha256:8c12f7e76f208148cc71c65bbdf229e195df6099a99512ee4283398d39414eba:"
        },
