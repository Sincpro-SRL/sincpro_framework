  "claims": [
    {
      "id": "claim_a8f0d780cefc4db3a9036736d9461dfc",
      "statement": "`sincpro_framework/entrypoints/` is the protocol-agnostic layer every driving adapter shares: its catalog module docstring rules out FastMCP, Starlette and argparse types there, and the package `__init__.py` re-exports only `Catalog` and `PackedFeatureOrAppService`, with the host libraries declared as optional extras.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L35-L48",
          "version": "repo-lines-v1:sha256:24556bebf7c325c6e6497c27426589bcdb2565e6794e9663f6818d361609d65e:"
        },
        {
