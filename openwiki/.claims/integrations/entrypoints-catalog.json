    {
      "id": "claim_a1344c23f47640a695b0abfc7fac3b76",
      "statement": "`PackedFeatureOrAppService` is the single DTO a host meets: `name` (the DTO class name / bus key), `layer`, `description`, `dto`, `json_schema` and a bound `run` callable. Its docstring states `json_schema` is the input DTO's schema computed once here and that hosts must not recompute it; being a `DataTransferObject` with `arbitrary_types_allowed=True` is what lets it carry a live callable alongside the JSON-safe fields.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L20-L35",
          "version": "repo-lines-v1:sha256:e19f9444570efdd19bc648877ca4e93369bd8782586055b61b55d2711216db16:"
        },
        {
