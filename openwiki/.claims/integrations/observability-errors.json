    {
      "id": "claim_1aa54e500f7e4383b915b6d84b258c6f",
      "statement": "record_error has four silent skip conditions, and the ignore check is guarded by kind == \"instance\" and runs before the framework identity swap, so types registered in ignore_sentry_exceptions never filter framework-kind events even when the list contains Exception.",
