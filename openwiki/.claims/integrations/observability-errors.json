  "claims": [
    {
      "id": "claim_94a7bf8cbe51400b9aeedd89b5885649",
      "statement": "Error reporting creates the framework's own isolated sentry_sdk.Client per release and never calls sentry_sdk.init(), so the host's (Odoo's, FastAPI's) global client and its errors stay untouched and keep reporting under the host's own release; consequently the host may capture the same exception object with its own release, which is intended rather than a duplicate to suppress.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/errors/record_error.py#L24-L28",
          "version": "repo-lines-v1:sha256:22a15c65742808f68298d8bdbe8e1871f38307d6b8ab6f537ee0075f32bbae5c:"
        },
        {
          "resource": "repo://sincpro_framework/observability/errors/setup.py#L1-L6",
          "version": "repo-lines-v1:sha256:e9032bb9ea67bd45e289000381814adc5bbce9eea549c8a19840803064dd47e4:"
        },
        {
          "resource": "repo://sincpro_framework/observability/errors/setup.py#L44-L69",
          "version": "repo-lines-v1:sha256:9c2627a8baa01e608b0462be454c49b36ae8d47a57d77e73faaaac4269aff304:"
        }
      ]
    },
    {
      "id": "claim_5cf82d6b1e4b44069734d8fcd9bd5c2a",
      "statement": "The framework's Sentry client is constructed with traces_sample_rate=0.0, auto_enabling_integrations=False and send_default_pii=False, so traces are deliberately never sent to GlitchTip and the SDK does not enable integrations or attach PII behind the host's back.",
      "evidence": [
        {
          "resource": "repo://README.md#L980-L980",
          "version": "repo-lines-v1:sha256:f0b089bdcffe6500b36be43d772da44c3053d379ec466fc3b7ce322d96cffefe:"
