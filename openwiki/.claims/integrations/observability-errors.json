    {
      "id": "claim_41deb32c136642158cd2c083f26e7157",
      "statement": "The bus reports the error before consulting handle_error: FeatureBus.execute and ApplicationServiceBus.execute each call observability.record_error inside their except block and only afterwards return handle_error(error) or re-raise, so a handler that swallows an unexpected exception still produces a GlitchTip event, and an exception crossing two delegating layers produces two events (sincpro.layer feature then application_service) with no capture marker to suppress either.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L116-L120",
          "version": "repo-lines-v1:sha256:7d3f9bd5d6ed2cb14f04ee3393dc7a8806849699d2cad18337bd5a9bfc9f0577:"
