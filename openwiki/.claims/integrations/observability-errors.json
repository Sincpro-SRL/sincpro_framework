    {
      "id": "claim_726f39e620124ee489c1c1f61857ad44",
      "statement": "The GlitchTip release is literally APP_RELEASE when set (taken verbatim, never split into name and version), otherwise artifact:version from whichever source resolved the artifact; the bus is not part of the release and two buses of one deployment are told apart by the sincpro.instance tag, with the bus standing in as the artifact only when nothing else resolves.",
      "evidence": [
