    {
      "id": "claim_6b9a3154b4034bb4b204ae118ea697a5",
      "statement": "Events are captured inside a sentry_sdk.isolation_scope() whose client is set with scope.set_client(client) when the installed SDK exposes it; the same scope carries the tags sincpro.kind and sincpro.layer always, sincpro.dto when the DTO name is non-empty, sincpro.instance when the bus is non-empty, sincpro.package when the artifact is known and not \"unknown\", and tenant when settings.tenant is non-empty, then sentry_sdk.capture_exception(error).",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/errors/record_error.py#L40-L62",
          "version": "repo-lines-v1:sha256:8f89583d8268b3cbadd865493b8be2126835947f8f04b94ce1218914149e15c1:"
