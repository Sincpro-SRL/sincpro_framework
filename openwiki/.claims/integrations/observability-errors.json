    {
      "id": "claim_4faff47fbba241ce9bb4d5ac8ab0ac73",
      "statement": "Error reporting degrades to a ComponentStatus instead of raising: off(\"sdk_missing\") when sentry_sdk is not importable, off(\"dsn_missing\") when the conf DSN is absent or unusable, on(\"init\") when the client exists, failed(\"client_not_created\") when no client came back, and failed(<truncated exception text>) when client construction raised; record_error itself is wrapped so it always returns silently.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/domain.py#L90-L94",
          "version": "repo-lines-v1:sha256:b971ecf938018dc87b87c16a45cc74156e30f43fb226b1496ca7d84be9332e23:"
