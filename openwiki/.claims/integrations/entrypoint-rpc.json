    },
    {
      "id": "claim_9b720fbd72b547049ae0b78120392d99",
      "statement": "The discovery document is OpenRPC 1.4.0 shaped as {openrpc, info: {title, version}, methods}, with the synthesised rpc.discover method always first; title and version default to \"sincpro-rpc\" / \"1.0.0\" and are constructor arguments of RpcGateway and build_rpc_app.",
      "evidence": [
