        }
      ]
    },
    {
      "id": "claim_39e4779357d84bf3bae826bf1b683006",
      "statement": "Non-JSON operations are never addressable over this wire: index_methods asks the catalog with filter_binaries_schema=True, so a DTO carrying bytes (a bytes field or format binary/byte anywhere in the schema tree) is skipped with a warning at catalog time and remains callable only in-process via framework(dto).",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L147-L156",
          "version": "repo-lines-v1:sha256:26db4ae3d4312f1a6cde89c03ba61196114c4537debb7fb15a833eb803f87bb5:"
