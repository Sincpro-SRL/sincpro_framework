    {
      "id": "claim_1a06e4f3d06b492d9bda7ee87b1a3042",
      "statement": "These method names are reserved for the framework's own namespace and must not be shared with FastMCP's JSON-RPC methods: entrypoint_mcp serves MCP over JSON-RPC (tools/list, tools/call), so an MCP host and an RPC host must not share an HTTP port, and the alias may not contain dots because the dot separates alias, layer and DtoName.",
