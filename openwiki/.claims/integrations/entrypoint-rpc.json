        }
      ]
    },
    {
      "id": "claim_1ecf68c4c4994f1980c576a87c5e2239",
      "statement": "The rpc extra is declared as starlette + uvicorn in pyproject (rpc = [\"starlette\", \"uvicorn\"]) so the core bus installs without an RPC stack, and run(host=\"127.0.0.1\", port=8080, **kwargs) is the only place the bind address is chosen, forwarding extra kwargs to uvicorn.run. build_rpc_app(instances, layers, title, version) is exactly RpcGateway(...).app().",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L36-L48",
