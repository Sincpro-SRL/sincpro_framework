    },
    {
      "id": "claim_1f323ba6c5ae41d6922fd509b2b04b53",
      "statement": "params must be a by-name JSON object: None or absent becomes an empty payload, a dict is passed through unchanged, and anything else — arrays included — raises InvalidParams, answered as -32602 Invalid params with data = \"params must be a JSON object (by-name)\"; there is no positional form, matching the paramStructure \"by-name\" the discovery document advertises.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/rpc/jrpc.py#L126-L128",
          "version": "repo-lines-v1:sha256:b66c8fbf93673754107ab5fa3d678ab6d48895f10c1af78c55c78890aba98a67:"
        },
        {
