          "version": "repo-lines-v1:sha256:77bacfb9c5637fe9772f9ee79835af6dff506b875ca60b6b09b1e60291f567ef:"
        },
        {
          "resource": "repo://tests/entrypoint/test_entrypoints.py#L284-L307",
          "version": "repo-lines-v1:sha256:76e87238f847bd2c23fe04843ecd9075958df6d6e6b69b1980b478cbe63bd916:"
        }
      ]
    },
    {
      "id": "claim_836a36d221874adf9c655cd5955b1163",
      "statement": "The JSON schema the packed entry carries (json_schema, computed once by the catalog) is not passed to mcp.tool; FastMCP derives the advertised input schema from the stamped function signature, and the precomputed schema is what the catalog's binary filter inspects.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L91-L100",
          "version": "repo-lines-v1:sha256:0613aebf47d05f1aeef843caabbb1bb6f4733d25106720db9fdcc33ac5f952be:"
