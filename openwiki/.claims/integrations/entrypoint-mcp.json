  "claims": [
    {
      "id": "claim_b8a11a648d9b4519b7661be86fd0a7a2",
      "statement": "The MCP entrypoint is a thin facade over the shared, protocol-agnostic Catalog: Entrypoint.__init__ constructs one Catalog over the given UseFramework instance and never reimplements the projection, so layer vocabulary, include/exclude/wrap policies, JSON schema computation and binary filtering stay in sincpro_framework/entrypoints/catalog.py.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L38-L56",
          "version": "repo-lines-v1:sha256:cf19667685a0a70d13ecc649e35ead401aea0dbad92069c5fa624ebd06945fcd:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/entrypoint.py#L11-L22",
          "version": "repo-lines-v1:sha256:f83ec8625e14877385f53996911afa3f7835608ad55917cea0d2ecaa728a82ff:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/entrypoint.py#L55-L55",
          "version": "repo-lines-v1:sha256:a0f407dbf9ee3bc3d1351d5040925ca62d7a012d8557547b21b0386979402adc:"
        }
      ]
    },
    {
      "id": "claim_4fd8cf3669784bd481607aa0f0b3fb37",
      "statement": "Constructing Entrypoint materialises the bus: the Catalog constructor calls framework_instance.build_root_bus() when was_initialized is false, so a host built from an uninitialised UseFramework still has registries to publish.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L47-L50",
          "version": "repo-lines-v1:sha256:d5d2625e90df60b2d01b5478cb93efa9a34372082a5de4014df26bc2bd6348d2:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/entrypoint.py#L14-L15",
          "version": "repo-lines-v1:sha256:b81a20852f8863bbad8ce11c450ed75121aa91c4a7d8d19efd0720b3c4e16b69:"
        }
      ]
    },
    {
      "id": "claim_2779599bf59d4ac4a6491b5ef9649b2d",
      "statement": "FastMCP is an optional dependency only: pyproject declares fastmcp >=3.0,<4 as optional behind the 'mcp' extra, and neither the rest of sincpro_framework nor the mcp package imports it at module import time, so the bus installs and runs without an MCP stack.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L35-L35",
          "version": "repo-lines-v1:sha256:3b521fa6e524c622c77050a8b7dc70c04a918c1ac40f5ba7ce43dae92395c769:"
        },
        {
          "resource": "repo://pyproject.toml#L47-L47",
          "version": "repo-lines-v1:sha256:047ae1500265e243d915a6b8937e3d6c9bddfacd9dcd081ca4d6dc9091e5e2cb:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/mcp.py#L1-L10",
          "version": "repo-lines-v1:sha256:a73961202cfc0f93ce616903071667c9944d722f39ee483bce4eb65f8dbf4712:"
        }
      ]
    },
    {
      "id": "claim_19c5ce8436424d9c829baaad7418ddde",
      "statement": "A missing fastmcp extra produces a named ImportError, not a silent failure: Entrypoint.server() defers 'from fastmcp import FastMCP' into its body and re-raises ImportError(FASTMCP_MISSING), whose message names the fix 'pip install sincpro-framework[mcp]', chained from the original import error. It therefore fires when a server is built (server(), run() or build_mcp_server()), not when the package is imported.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/entrypoint.py#L49-L52",
          "version": "repo-lines-v1:sha256:e5a2ccae4963b70269e36fa2cd92500cbcd8bf56d9c6bcdb4b1bdcdc11fcc1de:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/mcp.py#L10-L10",
          "version": "repo-lines-v1:sha256:fec932f18d2f245f3c7f1e635a2a6997575c535ed2f83f0722374e1b02d993d8:"
        },
        {
          "resource": "repo://tests/entrypoint/test_entrypoints.py#L253-L258",
          "version": "repo-lines-v1:sha256:d07a297bbdfa926950fff9454efc7b95ca8ef9a47c008f43389ca0b2057ee41c:"
        }
      ]
    },
    {
      "id": "claim_b15bf0474b0046daab1833803e01b771",
      "statement": "build_mcp_server(instance, name=None) is exactly Entrypoint(instance).server(name=name), and the FastMCP server name defaults to the bounded context's own logger name (framework_instance._logger_name) when no name is passed.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/entrypoint.py#L17-L19",
          "version": "repo-lines-v1:sha256:7566dc46f568bdb762e8c77f0b5ede8060deedd4c3fe53f913035656d83fed56:"
