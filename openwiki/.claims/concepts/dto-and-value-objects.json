        }
      ]
    },
    {
      "id": "claim_806ad911f59c42d8b3e56c7eff8f37b8",
      "statement": "A rejecting validate_fn does not propagate as ValueError: pydantic wraps it in ValidationError, and the JSON-RPC dispatch maps ValidationError into -32602 InvalidParams while any other exception becomes -32603 Internal error; json_safe_validation_errors exists because for a value_error pydantic puts the raw exception in ctx.error, which would make json.dumps of the error envelope raise.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/rpc/jrpc.py#L126-L132",
          "version": "repo-lines-v1:sha256:50eab4e9bb9d0c7a44673750f19de58833f0edb62c2d7d8da08a737a950cb1a5:"
