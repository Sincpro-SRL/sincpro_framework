        }
      ]
    },
    {
      "id": "claim_1748419c84c54ee5b4ac6873822452c9",
      "statement": "The class-name identity has three enforced consequences: registering a second DTO with the same name in the same layer raises DTOAlreadyRegistered, a name present in both the feature and application-service registries raises DTOAlreadyRegistered at FrameworkBus construction and is re-checked on every execute call, and executing a DTO that is registered nowhere raises UnknownDTOToExecute.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L150-L162",
          "version": "repo-lines-v1:sha256:ed1f435d2c77cc7b7c37cda33e0b7e0f4b5980ab47d30de61a196a671d63b392:"
