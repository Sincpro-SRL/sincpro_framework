    {
      "id": "claim_6139e98b62b0454cb4556e3883295bfd",
      "statement": "ValueObject(base, validate_fn=None, name=None) is a factory (not a base class) exported from sincpro_framework.ddd; an internal builder subclasses base at runtime and stamps the generated class: __name__ and __qualname__ become name or base.__name__, __module__ becomes the base type's module, and __repr__ becomes f\"{name}({super().__repr__()})\" so the object still behaves as the primitive while printing with its domain name.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/ddd/__init__.py#L1-L1",
          "version": "repo-lines-v1:sha256:e1cc4da3122026ad31a1fad17ad179522031a65e7d2952f8b045cffac01adbf0:"
        },
        {
          "resource": "repo://sincpro_framework/ddd/value_object.py#L50-L74",
          "version": "repo-lines-v1:sha256:a79921d2744d4a92139a2ca160bfbbe080b28154226a815a7e27869ec9fb327a:"
        },
        {
