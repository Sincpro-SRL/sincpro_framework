    {
      "id": "claim_f449a3be1ecd4249886173ff7572e0eb",
      "statement": "A DTO whose schema tree or field annotations are not JSON-safe cannot be published on a JSON wire: is_binary_free walks the whole schema (properties, $defs/definitions, items, additionalProperties, anyOf/oneOf/allOf, with a seen set for cyclic $defs) looking for format binary/byte and separately checks the DTO's annotations against BINARY_TYPES (bytes, bytearray, memoryview); Catalog.get_scalar_use_cases(filter_binaries_schema=True) drops such entries with a warning, while dto_is_json_serializable exposes the same decision as a public predicate.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L116-L156",
          "version": "repo-lines-v1:sha256:6e61044a76b425d0fe25c897a6d673cf44ae5de0e9f709f668dcf417dcd0e703:"
        },
