    {
      "id": "claim_f8c91ddec1f84aedaa9baf751d4cc1dc",
      "statement": "DataTransferObject is declared exactly once as a pydantic v2 BaseModel in sincpro_framework/sincpro_abstractions.py with model_config setting arbitrary_types_allowed=True and use_attribute_docstrings=True, and is re-exported from the package root so applications do not import the module directly.",
