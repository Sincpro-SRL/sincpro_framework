      "id": "claim_6503853613c74bc48f1a654524c18162",
      "statement": "use_attribute_docstrings=True makes a bare string literal after a DTO field become that property's JSON Schema description (alongside Field(description=...)), and json_utils.dto_json_schema is the single wrapper over model_json_schema() that the catalog and both JSON hosts publish as the input schema.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L97-L97",
          "version": "repo-lines-v1:sha256:2a85c7ad7cec7272ca335ead2801376249ab7012571fde80b9c7f091134f1e34:"
