          "version": "repo-lines-v1:sha256:56bbf29a0bd27bc179a81540d5dc968a96e81849b62be7ecfc876ab05467db91:"
        }
      ]
    },
    {
      "id": "claim_483b248bc8f649148012304dcff07240",
      "statement": "A DTO is identified by its class name (__name__), not by an id or registry object, in three places: dto_registry and the layer registries at decoration time (ioc._register_service), the per-layer bus registries (feature_registry/app_service_registry keyed by dto.__name__), and dispatch (feature_registry[dto.__class__.__name__].execute(dto)).",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L30-L39",
          "version": "repo-lines-v1:sha256:d8c070c09a507301517ac83bf4d2eb886097377c05d96e0a8f1195975760cc95:"
        },
        {
