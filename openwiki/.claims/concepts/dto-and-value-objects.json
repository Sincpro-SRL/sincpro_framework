        }
      ]
    },
    {
      "id": "claim_219cb31b1d494f1f9fba48c242f03504",
      "statement": "DTO construction is pydantic validation on both paths — the keyword constructor and model_validate(payload) — and the wire boundary validates the payload into the DTO (dto_type.model_validate(payload)) before calling the framework, so a Feature or ApplicationService never receives an unvalidated dict.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/mcp.py#L27-L28",
          "version": "repo-lines-v1:sha256:83a8095156f4d71c02ddd93703c4d3e5ec2e83c6dce2436dbcd710a33dc5a50b:"
        },
