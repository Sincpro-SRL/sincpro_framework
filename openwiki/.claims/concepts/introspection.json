          "version": "repo-lines-v1:sha256:02d39a0d00435c011c2303fc2ee0068bff334004c14ec571339269cbfb9885d8:"
        }
      ]
    },
    {
      "id": "claim_afc8e470eb254ba0b412b1631431d7eb",
      "statement": "The description resolved by introspection is user-visible on the wire: the catalog copies `metadata.description` onto `PackedFeatureOrAppService`, the MCP host uses it as the FastMCP tool description, and the JSON-RPC host emits it as the OpenRPC method `summary` (first line) and `description`.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/entrypoints/catalog.py#L91-L100",
          "version": "repo-lines-v1:sha256:0613aebf47d05f1aeef843caabbb1bb6f4733d25106720db9fdcc33ac5f952be:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/mcp/entrypoint.py#L55-L61",
          "version": "repo-lines-v1:sha256:64dca63a6e71e650aff897ed8dda9f73bfe1789b25a1074490339da001732da6:"
        },
        {
          "resource": "repo://sincpro_framework/entrypoints/rpc/jrpc.py#L185-L195",
          "version": "repo-lines-v1:sha256:58a63c19154e1f840bdc377660f28106d6262174cd8b0d636654508837265671:"
        },
        {
          "resource": "repo://tests/entrypoint/test_entrypoints.py#L157-L162",
          "version": "repo-lines-v1:sha256:f2d5d3e0ee93b8bc1d5ad5aed2071fe97ad260cf095eade328459b3e954adb74:"
        }
      ]
    },
    {
      "id": "claim_c17de629ea0c4935aa4611b23ae7b46f",
      "statement": "All four introspection entry points are read-only and uncached — each call re-reads the live registry dicts and returns a fresh mapping, and no code path in the module mutates a registry, a handler instance or the framework.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/introspection/inspector.py#L78-L118",
          "version": "repo-lines-v1:sha256:d3153f33213b6d06aa8295a06244c9d38900323f6a72dc7f53ae449e29193d66:"
        }
      ]
    },
    {
      "id": "claim_df212546592141a7a5e9e38a2ffb126a",
      "statement": "Because `FrameworkBus.__init__` rejects a DTO name that appears in both layer registries with `DTOAlreadyRegistered`, the keys returned by `features()` and `app_services()` are disjoint, so one DTO name can never be described twice across the two calls.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L150-L162",
          "version": "repo-lines-v1:sha256:ed1f435d2c77cc7b7c37cda33e0b7e0f4b5980ab47d30de61a196a671d63b392:"
