        }
      ]
    },
    {
      "id": "claim_9e1faca677234dd0baff1168052c70ed",
      "statement": "Dependencies reach Feature and ApplicationService instances only through build_root_bus(): _add_dependencies_provided_by_user, called from that build alone, reads each bus provider's attributes[\"feature_registry\"]/[\"app_service_registry\"] kwargs and calls add_attributes(**dynamic_dep_registry) on every registration entry, which is the step that makes the dependency an attribute of the handler class rather than of the framework.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/sincpro_abstractions.pyi#L84-L87",
