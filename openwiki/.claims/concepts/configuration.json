          "version": "repo-lines-v1:sha256:9110d5897aeec891aa8b7d9892cd5bbb640acca332a5249259abe44746f20e55:"
        }
      ]
    },
    {
      "id": "claim_04bcfdff707b4cbca1f6b7c325efac5c",
      "statement": "`tenant` is stripped and used in two places: as the Sentry client's `environment` when non-empty, and as the `tenant` tag applied to every recorded event.",
