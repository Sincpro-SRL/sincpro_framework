          "version": "repo-lines-v1:sha256:63cd234814e195654d876e955b68e018dbc9619e32b765930efaa08e0ece018d:"
        }
      ]
    },
    {
      "id": "claim_d3d9a06d65d0456cba7c589dcf47d846",
      "statement": "`otlp_endpoint` is the exporter destination rather than a boolean gate: when unset the setup either returns `on(\"host\")` if a non-placeholder global provider already exists or `off(\"no_endpoint\")`, and when set the value is passed explicitly as `OTLPSpanExporter(endpoint=endpoint)` because the SDK would otherwise ignore this conf and fall back to its own environment variable or localhost:4317.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/tracing/setup.py#L142-L149",
          "version": "repo-lines-v1:sha256:8e19210a944031e51a5697d363659855f30cda561b4ec6db19daf19721151642:"
        },
        {
          "resource": "repo://sincpro_framework/observability/tracing/setup.py#L92-L95",
          "version": "repo-lines-v1:sha256:91ca53ad1e8ec1e8677794ec1eb49992d2cfc14885e499331123e896b331f4cb:"
        }
      ]
    },
    {
      "id": "claim_bc9471337be447029782b7952a04e344",
      "statement": "`otlp_traces_sample_rate` is converted by `_root_sampler` into `ALWAYS_ON` at 1.0 or above, `ALWAYS_OFF` at 0.0 or below, and `TraceIdRatioBased(ratio)` in between, and the TracerProvider wraps it in `ParentBased` so a sampling decision already taken upstream always wins over this ratio.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/tracing/setup.py#L59-L72",
          "version": "repo-lines-v1:sha256:09f9a0bee94da5881d3d271c5848b58ecefb89b22205439f33b1d5fc9f7a0b9b:"
        },
        {
          "resource": "repo://sincpro_framework/observability/tracing/setup.py#L86-L91",
          "version": "repo-lines-v1:sha256:45dac83cedbadc043e38762ff3e2a1e82dbff30fea6a5ddd2f9d3c7558aff19e:"
        }
      ]
    },
    {
      "id": "claim_23e0f8117aae4a78ba61c9a34f2b6ae2",
      "statement": "`sentry_dsn` is accepted only when it is non-empty, starts with `http://` or `https://` and contains `@`; anything else (and any exception while reading the setting) yields an empty DSN, which makes the error backend report `off(\"dsn_missing\")` while the bus keeps running.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/errors/setup.py#L33-L41",
          "version": "repo-lines-v1:sha256:399e57d457e97d7a17a8e35a0b33869f32cd24c023769534dc13e2fcfd4e32cf:"
