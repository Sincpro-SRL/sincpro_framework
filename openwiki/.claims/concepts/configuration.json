    {
      "id": "claim_1f03f9f6dc8144cab91dcdc61fd34c7a",
      "statement": "A service does not assign into the framework's settings: tests fake deployments with `monkeypatch.setattr(settings, ...)`, and configuration fields are the module-level `settings` object's attributes, which is why the supported change surface is the environment.",
      "evidence": [
