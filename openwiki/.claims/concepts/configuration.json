    {
      "id": "claim_caedf9a548ab494fbdbe73b7b343ed72",
      "statement": "`app_release` and `otel_service_name` form the deployment branch of identity resolution: `APP_RELEASE` is taken verbatim when non-empty and `OTEL_SERVICE_NAME` only names the deployment when it is absent, and that single resolved artifact feeds both the OTel `service.name` (`artifact:version:bus`) and the GlitchTip release (`artifact:version`, bus excluded).",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/domain.py#L173-L183",
          "version": "repo-lines-v1:sha256:1282eb0032e014e5fb88c088b019ec74b005cb30a94759d4df327b7b43250049:"
