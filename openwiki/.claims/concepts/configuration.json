        }
      ]
    },
    {
      "id": "claim_a206947ff01e4c74b83b499fde16f6d2",
      "statement": "Only four modules read `settings`: `sincpro_logger.py` (the three log fields), `observability/domain.py` (`app_release`, `otel_service_name`), `observability/errors/setup.py` (`sentry_dsn`, `tenant`) and `observability/tracing/setup.py` (`otlp_endpoint`, `otlp_traces_sample_rate`); the logger consumes them at import, while observability consumes them when a bus is built via `observability.start(self.logger)` in `build_root_bus()`.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/observability/domain.py#L16-L16",
          "version": "repo-lines-v1:sha256:1bb367878d2edb3517296807634d9546c34aee48a750ec2097c9e26192e489e5:"
        },
