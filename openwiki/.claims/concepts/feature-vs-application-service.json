    {
      "id": "claim_0e6f5352310b46119809d50c2028d1c1",
      "statement": "Because an ApplicationService's only execution handle is the FeatureBus, delegating to a DTO registered in the application-service layer cannot route back to that layer: FeatureBus looks the name up in feature_registry alone, so the mismatch surfaces as the registry KeyError, wrapped by FeatureBus's own except and its feature-level handle_error.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L41-L64",
          "version": "repo-lines-v1:sha256:fcffc84fdb4f9650d070070b7f286cfaeb40a92ee6ab666402b672a6bb6d7a18:"
