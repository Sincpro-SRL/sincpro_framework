        }
      ]
    },
    {
      "id": "claim_ec68994a49944bfc80b7f921dfe3b5c5",
      "statement": "A DTO name present in both registries is rejected twice: FrameworkBus's constructor raises DTOAlreadyRegistered after intersecting feature_registry and app_service_registry keys, and FrameworkBus.execute re-checks the same intersection on every call before routing.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L150-L162",
          "version": "repo-lines-v1:sha256:ed1f435d2c77cc7b7c37cda33e0b7e0f4b5980ab47d30de61a196a671d63b392:"
