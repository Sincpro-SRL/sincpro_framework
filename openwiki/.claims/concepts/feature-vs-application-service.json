    {
      "id": "claim_a1e14f6b274a42fca317b22b352bc8e3",
      "statement": "The typed contract of the handler base classes lives in the hand-written stub sincpro_framework/sincpro_abstractions.pyi rather than the runtime module: the stub declares Feature/ApplicationService as Generic[TypeDTO, TypeDTOResponse, ContextT], types self.context as ContextT, and adds __getattr__(self, name: str) -> Any plus bind_to_framework, which is why injected-dependency autocomplete must come from the user's own typed base classes instead of a bare Feature.",
      "evidence": [
        {
          "resource": "repo://README.md#L410-L470",
          "version": "repo-lines-v1:sha256:618e5d8b71699edd834fd08cde5bc27771e942128510df570f86136a17dc64f4:"
