    {
      "id": "claim_a39646c112284e80ae777397a1faee32",
      "statement": "add_dependency only writes dynamic_dep_registry (refusing a duplicate name with DependencyAlreadyRegistered); a dependency becomes an attribute of a Feature/ApplicationService during build_root_bus, which is the only step that pushes that registry onto the registration entries — so a dependency registered after the first build reaches no handler.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/use_bus.py#L125-L125",
          "version": "repo-lines-v1:sha256:51386fd02904177b1c64bc7dd7162c343658713dc6611311394fe07d5f6964dd:"
