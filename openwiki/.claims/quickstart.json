    {
      "id": "claim_d0f7268bee3840dd9bdaf46825582407",
      "statement": "sincpro-framework is an importable Python library, not an application: it is declared as a single poetry package with no executable of its own, and what the repository produces is a distribution published to Gemfury and PyPI that downstream SDKs and services import to build their own bounded contexts.",
      "evidence": [
        {
          "resource": "repo://Makefile#L120-L133",
          "version": "repo-lines-v1:sha256:501e430c2f7b16364f6710a756a09eb2ff0efac15ce87510d1b26dc0c412d5b6:"
        },
        {
