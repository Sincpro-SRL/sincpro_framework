        }
      ]
    },
    {
      "id": "claim_d8184878edb94cf3b6d1abc18e2897c6",
      "statement": "The public API surface is exactly the eight names exported by sincpro_framework/__init__.py — UseFramework, Feature, ApplicationService, DataTransferObject, Middleware, logger, TypeDTO, TypeDTOResponse — while every other module (ioc.py, bus.py, deps.py, context/, observability/, entrypoints/, introspection/, aio/, ddd/) is internal; the observability package states its own internals are an implementation detail of the two objects it exposes.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/__init__.py#L1-L21",
          "version": "repo-lines-v1:sha256:0563d98fe795f3c62b4017629f1c1daa360e2cb9a7abec3bec25bfa4be83706b:"
