    {
      "id": "claim_0abfa75cb9924b8a8cc4cde55b9ea662",
      "statement": "A UseFramework instance is one bounded context: its __init__ creates the FrameworkContainer, the two decorator attributes bound to that container, the dependency registry behind framework.deps, the context storage, the error-handler chains and the middleware pipeline, so registrations and state never cross instances.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/ioc.py#L49-L57",
          "version": "repo-lines-v1:sha256:db9056d4a3bf57f5f89356f619ce474175cc70718dbb7ca4e7b18f8684b65c47:"
