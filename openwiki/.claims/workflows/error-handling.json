    },
    {
      "id": "claim_2689f8e0e8bd441d8a7f2810ec2173f6",
      "statement": "`handle_error` is a plain mutable optional-callable attribute on each bus, so a hand-wired bus built through `register_feature` / `register_app_service` can assign it directly and skip `UseFramework` entirely — no chain composition, no accumulation in a list and no callable validation.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L30-L39",
          "version": "repo-lines-v1:sha256:d8c070c09a507301517ac83bf4d2eb886097377c05d96e0a8f1195975760cc95:"
