          "version": "repo-lines-v1:sha256:6d5769d1f93a98c977778e3fdc35f3a093ce52eb580181e684414139c1d273bf:"
        },
        {
          "resource": "repo://sincpro_framework/use_bus.py#L221-L224",
          "version": "repo-lines-v1:sha256:b902b599811762e6fb468fda46b86b11a683eda51168701a160ba5228061985e:"
        },
        {
          "resource": "repo://sincpro_framework/use_bus.py#L233-L238",
          "version": "repo-lines-v1:sha256:0190d8a82941a031c425dc2bcec014f3577d4963ba7d13205026b22bd9fd5798:"
        }
      ]
    },
    {
      "id": "claim_6e04c1765c5c4e10a1688c73bf76b90a",
      "statement": "All three `add_*_error_handler` methods reject a non-callable with `TypeError(\"The handler must be a callable\")` before appending it, so the rejected object never enters the scope's chain list; this validation exists only on the `UseFramework` API, unlike `add_middleware` which appends without checking.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/middleware.py#L30-L32",
          "version": "repo-lines-v1:sha256:51119f779d019f99c542723889c29be17f2079509f8373466131f726024888ad:"
