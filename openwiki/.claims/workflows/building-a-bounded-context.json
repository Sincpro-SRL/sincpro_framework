    {
      "id": "claim_bfc8a0850686428ab24c58716a93def3",
      "statement": "UseFramework[DependencyContextType] is a static-typing device only: UseFramework is Generic over TDeps with a default of Any, the annotations on the typing-only class are never read at runtime, and nothing validates that the object registered under a name matches the declared type — the only runtime guard in add_dependency is a duplicate name.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/deps.py#L9-L9",
          "version": "repo-lines-v1:sha256:69dea523affa10025732ffb2d1f2279738922611cc7ec42886d8cdb769234f0c:"
