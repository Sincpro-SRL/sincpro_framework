  "claims": [
    {
      "id": "claim_fccd815af7f340a98a02ecb6d30eabd1",
      "statement": "A bounded context is exactly one UseFramework instance: __init__ creates the per-instance FrameworkContainer and binds self.feature / self.app_service as functools.partial over that container, so the two decorators exist only after the constructor has run and every decoration writes into exactly one instance's container.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/ioc.py#L153-L171",
          "version": "repo-lines-v1:sha256:9498467b25baa0f3a20264e25190c57289978e1e7b51748a8894db790749b5b1:"
        },
        {
          "resource": "repo://sincpro_framework/use_bus.py#L60-L70",
          "version": "repo-lines-v1:sha256:d9300dd12c8fbdcbdcfc36f4c987bfe1df2fcd77a7fed91ee0132dcc541156d4:"
        }
      ]
    },
    {
      "id": "claim_7abd227a07d44331a4903211e1215b6c",
      "statement": "Decoration is a registration-only operation: inject_feature_to_bus / inject_app_service_to_bus return the decorated class unchanged, and _register_service is the sole writer, updating the container's dto_registry and the layer registry with a fresh providers.Factory per DTO name and attaching that registry to the layer's bus provider.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/ioc.py#L153-L191",
          "version": "repo-lines-v1:sha256:01f1d5ae18573bb0578fa23427cf8f2e34b053c982110235dabe6dfcccf5b583:"
        },
        {
          "resource": "repo://sincpro_framework/ioc.py#L84-L150",
          "version": "repo-lines-v1:sha256:dda62c908999bf59fdc0113136f30b2145ecd2235545301c534f49650ca633f2:"
        }
      ]
    },
    {
      "id": "claim_315f6f2452ae4600a02d3c38e25020ce",
      "statement": "Nothing in the framework scans modules for decorated classes: registration is a side effect of importing the module that defines them, so a service module that is never imported registers nothing, the build still succeeds over a shorter registry, and invocation then fails with UnknownDTOToExecute at the facade.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/bus.py#L191-L194",
          "version": "repo-lines-v1:sha256:a52d744d5611c85a19d9ad5a90541384aeb1c9fa291e121840697a3fad103e99:"
        },
        {
          "resource": "repo://sincpro_framework/ioc.py#L153-L171",
          "version": "repo-lines-v1:sha256:9498467b25baa0f3a20264e25190c57289978e1e7b51748a8894db790749b5b1:"
        }
      ]
    },
    {
      "id": "claim_117d1bcacdc54212ac2f8d02ae1440ee",
      "statement": "SincproFrameworkNotBuilt is raised only when self.bus is still None after the lazy build in __call__, which is reachable because build_root_bus sets was_initialized True before materialising the facade; a first build whose FrameworkBus construction raises therefore propagates the original error to the first caller and leaves the instance permanently unusable, with every later call stopping at the not-built guard.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/exceptions.py#L17-L18",
          "version": "repo-lines-v1:sha256:376c46fdc0f5f7dc86d6f9530c284007358f7c074d5de1a81f6d4b5b0b63f2b9:"
        },
        {
