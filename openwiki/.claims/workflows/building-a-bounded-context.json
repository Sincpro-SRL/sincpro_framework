          "version": "repo-lines-v1:sha256:fbbcc95da5a83433923edc8286d413386258fef6ba519bb154cfec36e92d2384:"
        }
      ]
    },
    {
      "id": "claim_7bdf26a5115c42bd817c0cad4fb26113",
      "statement": "Handlers are materialised by the container at build time, not by the decorator: the application-service registry entries are providers.Factory(decorated_class, framework_container.feature_bus), which is how an ApplicationService whose __init__ takes feature_bus positionally receives it, and only framework_bus() evaluation creates the instances.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/ioc.py#L137-L147",
          "version": "repo-lines-v1:sha256:5e464599e0bd7aa75c0c82f1cb650c7bf4f1edb686b43dd9c81737e43af15591:"
