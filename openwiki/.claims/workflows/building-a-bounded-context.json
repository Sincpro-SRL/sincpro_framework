          "version": "repo-lines-v1:sha256:1eed09aebfbfe32b0ad592c9e65dfca2b8395843630b9033ff048ce96f883320:"
        }
      ]
    },
    {
      "id": "claim_d128e12a239447d0873fa9ce06a039b3",
      "statement": "Dependencies must be registered before the first build: _add_dependencies_provided_by_user is called only from build_root_bus and iterates the registration entries that exist at that moment, while add_dependency itself only writes the per-instance dynamic_dep_registry and refuses a duplicate name with DependencyAlreadyRegistered.",
      "evidence": [
        {
          "resource": "repo://sincpro_framework/use_bus.py#L123-L125",
          "version": "repo-lines-v1:sha256:e7b94cd133547fedad1659039cb335749cbc8033a3148a58d5f0de663e621afa:"
