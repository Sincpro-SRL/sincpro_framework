{
  "about": "The cases the filter language must answer the same way in every engine. Written by the Python suite (tests/ddd/test_criteria_parity.py) and read by both: the in-memory evaluator here and the TypeScript engine in @sincpro/criteria. Do not edit by hand.",
  "rows": [
    {
      "id": "a",
      "name": "labs.csv",
      "size": 300,
      "tags": [
        "raw",
        "urgent"
      ],
      "owner": "ana",
      "made_at": "2026-01-10T00:00:00Z"
    },
    {
      "id": "b",
      "name": "sales.csv",
      "size": 120,
      "tags": [
        "raw"
      ],
      "owner": "beto",
      "made_at": "2026-02-04T00:00:00Z"
    },
    {
      "id": "c",
      "name": "draft.csv",
      "size": 0,
      "tags": [],
      "owner": null,
      "made_at": "2026-02-18T00:00:00Z"
    },
    {
      "id": "d",
      "name": "stock.csv",
      "size": 900,
      "tags": [
        "clean"
      ],
      "owner": "ana",
      "made_at": "2026-03-02T00:00:00Z"
    },
    {
      "id": "e",
      "name": "LABS.TXT",
      "size": 120,
      "tags": [
        "urgent"
      ],
      "owner": null,
      "made_at": "2026-03-27T00:00:00Z"
    }
  ],
  "cases": [
    {
      "name": "equality",
      "selection": {
        "field": "owner",
        "operator": "=",
        "value": "ana"
      },
      "expected": [
        "a",
        "d"
      ]
    },
    {
      "name": "inequality",
      "selection": {
        "field": "owner",
        "operator": "!=",
        "value": "ana"
      },
      "expected": [
        "b"
      ]
    },
    {
      "name": "a null is not a value, so it answers neither",
      "selection": {
        "field": "owner",
        "operator": "!=",
        "value": "beto"
      },
      "expected": [
        "a",
        "d"
      ]
    },
    {
      "name": "is null",
      "selection": {
        "field": "owner",
        "operator": "is null",
        "value": true
      },
      "expected": [
        "c",
        "e"
      ]
    },
    {
      "name": "is not null",
      "selection": {
        "field": "owner",
        "operator": "is null",
        "value": false
      },
      "expected": [
        "a",
        "b",
        "d"
      ]
    },
    {
      "name": "greater than",
      "selection": {
        "field": "size",
        "operator": ">",
        "value": 120
      },
      "expected": [
        "a",
        "d"
      ]
    },
    {
      "name": "greater or equal",
      "selection": {
        "field": "size",
        "operator": ">=",
        "value": 120
      },
      "expected": [
        "a",
        "b",
        "d",
        "e"
      ]
    },
    {
      "name": "less than",
      "selection": {
        "field": "size",
        "operator": "<",
        "value": 120
      },
      "expected": [
        "c"
      ]
    },
    {
      "name": "less or equal",
      "selection": {
        "field": "size",
        "operator": "<=",
        "value": 120
      },
      "expected": [
        "b",
        "c",
        "e"
      ]
    },
    {
      "name": "zero is a value, not an absence",
      "selection": {
        "field": "size",
        "operator": "=",
        "value": 0
      },
      "expected": [
        "c"
      ]
    },
    {
      "name": "between, both ends included",
      "selection": {
        "field": "size",
        "operator": "between",
        "value": [
          120,
          300
        ]
      },
      "expected": [
        "a",
        "b",
        "e"
      ]
    },
    {
      "name": "in",
      "selection": {
        "field": "name",
        "operator": "in",
        "value": [
          "labs.csv",
          "stock.csv"
        ]
      },
      "expected": [
        "a",
        "d"
      ]
    },
    {
      "name": "not in leaves the nulls out",
      "selection": {
        "field": "owner",
        "operator": "not in",
        "value": [
          "ana"
        ]
      },
      "expected": [
        "b"
      ]
    },
    {
      "name": "like is case-insensitive and partial",
      "selection": {
        "field": "name",
        "operator": "like",
        "value": "labs"
      },
      "expected": [
        "a",
        "e"
      ]
    },
    {
      "name": "like reads a percent sign as itself, not as a wildcard",
      "selection": {
        "field": "name",
        "operator": "like",
        "value": "%"
      },
      "expected": []
    },
    {
      "name": "like reads an underscore as itself, not as any one character",
      "selection": {
        "field": "name",
        "operator": "like",
        "value": "s_c"
      },
      "expected": []
    },
    {
      "name": "starts with is case-insensitive and anchored at the start",
      "selection": {
        "field": "name",
        "operator": "starts with",
        "value": "LAB"
      },
      "expected": [
        "a",
        "e"
      ]
    },
    {
      "name": "starts with does not match in the middle",
      "selection": {
        "field": "name",
        "operator": "starts with",
        "value": "csv"
      },
      "expected": []
    },
    {
      "name": "contains asks about one member of a list",
      "selection": {
        "field": "tags",
        "operator": "contains",
        "value": "raw"
      },
      "expected": [
        "a",
        "b"
      ]
    },
    {
      "name": "not contains",
      "selection": {
        "field": "tags",
        "operator": "not contains",
        "value": "raw"
      },
      "expected": [
        "c",
        "d",
        "e"
      ]
    },
    {
      "name": "the empty-list question",
      "selection": {
        "field": "tags",
        "operator": "=",
        "value": []
      },
      "expected": [
        "c"
      ]
    },
    {
      "name": "the empty-list question, negated",
      "selection": {
        "field": "tags",
        "operator": "!=",
        "value": []
      },
      "expected": [
        "a",
        "b",
        "d",
        "e"
      ]
    },
    {
      "name": "a date compared as text, the way JSON carries it",
      "selection": {
        "field": "made_at",
        "operator": ">=",
        "value": "2026-03-01T00:00:00Z"
      },
      "expected": [
        "d",
        "e"
      ]
    },
    {
      "name": "and",
      "selection": {
        "all": [
          {
            "field": "size",
            "operator": ">",
            "value": 100
          },
          {
            "field": "owner",
            "operator": "=",
            "value": "ana"
          }
        ]
      },
      "expected": [
        "a",
        "d"
      ]
    },
    {
      "name": "or",
      "selection": {
        "any": [
          {
            "field": "owner",
            "operator": "=",
            "value": "beto"
          },
          {
            "field": "size",
            "operator": ">",
            "value": 500
          }
        ]
      },
      "expected": [
        "b",
        "d"
      ]
    },
    {
      "name": "not",
      "selection": {
        "negate": {
          "field": "owner",
          "operator": "=",
          "value": "ana"
        }
      },
      "expected": [
        "b",
        "c",
        "e"
      ]
    },
    {
      "name": "not over a null: an absence is not the value, and is not its negation either",
      "selection": {
        "negate": {
          "field": "owner",
          "operator": "is null",
          "value": true
        }
      },
      "expected": [
        "a",
        "b",
        "d"
      ]
    },
    {
      "name": "three levels deep",
      "selection": {
        "all": [
          {
            "field": "size",
            "operator": ">",
            "value": 0
          },
          {
            "any": [
              {
                "field": "tags",
                "operator": "contains",
                "value": "urgent"
              },
              {
                "negate": {
                  "field": "owner",
                  "operator": "is null",
                  "value": true
                }
              }
            ]
          }
        ]
      },
      "expected": [
        "a",
        "b",
        "d",
        "e"
      ]
    },
    {
      "name": "no filter answers everything",
      "selection": null,
      "expected": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ]
    }
  ],
  "crossing": {
    "about": "Filters that cross a relation (`through`): some record the relation holds — several, one or none — answers the selection.",
    "rows": [
      {
        "id": "s1",
        "lines": [
          {
            "product": "desk",
            "qty": 12
          },
          {
            "product": "chair",
            "qty": 1
          }
        ],
        "customer": {
          "city": "La Paz"
        }
      },
      {
        "id": "s2",
        "lines": [
          {
            "product": "lamp",
            "qty": 2
          }
        ],
        "customer": {
          "city": "Sucre"
        }
      },
      {
        "id": "s3",
        "lines": [],
        "customer": null
      },
      {
        "id": "s4",
        "lines": [
          {
            "product": "desk",
            "qty": 3
          }
        ],
        "customer": {
          "city": "La Paz"
        }
      }
    ],
    "cases": [
      {
        "name": "some line answers the selection",
        "selection": {
          "through": "lines",
          "selection": {
            "field": "qty",
            "operator": ">",
            "value": 10
          }
        },
        "expected": [
          "s1"
        ]
      },
      {
        "name": "a record holding no line answers no crossing",
        "selection": {
          "through": "lines",
          "selection": {
            "field": "qty",
            "operator": ">=",
            "value": 0
          }
        },
        "expected": [
          "s1",
          "s2",
          "s4"
        ]
      },
      {
        "name": "every line answers: no line answers the opposite",
        "selection": {
          "negate": {
            "through": "lines",
            "selection": {
              "negate": {
                "field": "qty",
                "operator": ">",
                "value": 1
              }
            }
          }
        },
        "expected": [
          "s2",
          "s3",
          "s4"
        ]
      },
      {
        "name": "the one record a to-one relation holds",
        "selection": {
          "through": "customer",
          "selection": {
            "field": "city",
            "operator": "=",
            "value": "La Paz"
          }
        },
        "expected": [
          "s1",
          "s4"
        ]
      },
      {
        "name": "a crossing beside a condition of the record",
        "selection": {
          "all": [
            {
              "field": "id",
              "operator": "!=",
              "value": "s1"
            },
            {
              "through": "lines",
              "selection": {
                "field": "product",
                "operator": "=",
                "value": "desk"
              }
            }
          ]
        },
        "expected": [
          "s4"
        ]
      }
    ]
  }
}
